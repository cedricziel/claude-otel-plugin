{
  "name": "opentelemetry-java",
  "version": "1.0.0",
  "description": "Expert knowledge for instrumenting Java applications with OpenTelemetry. Provides guidance on manual and automatic instrumentation, SDK configuration, and best practices for traces, metrics, and logs.",
  "capabilities": [
    "Manual instrumentation with OpenTelemetry Java API",
    "Automatic instrumentation with Java agent",
    "SDK configuration and setup",
    "Span creation and context propagation",
    "Metric collection and recording",
    "Log correlation",
    "Exporter configuration (OTLP, Jaeger, Prometheus, etc.)",
    "Resource detection and attributes",
    "Sampling strategies",
    "Baggage and context management"
  ],
  "dependencies": {
    "maven": [
      "io.opentelemetry:opentelemetry-api",
      "io.opentelemetry:opentelemetry-sdk",
      "io.opentelemetry:opentelemetry-exporter-otlp",
      "io.opentelemetry.instrumentation:opentelemetry-instrumentation-annotations"
    ],
    "gradle": [
      "io.opentelemetry:opentelemetry-api",
      "io.opentelemetry:opentelemetry-sdk",
      "io.opentelemetry:opentelemetry-exporter-otlp",
      "io.opentelemetry.instrumentation:opentelemetry-instrumentation-annotations"
    ]
  },
  "resources": [
    "https://opentelemetry.io/docs/languages/java/",
    "https://github.com/open-telemetry/opentelemetry-java",
    "https://github.com/open-telemetry/opentelemetry-java-instrumentation"
  ]
}
